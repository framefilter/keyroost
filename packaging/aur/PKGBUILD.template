# Maintainer: framefilter <https://github.com/framefilter/keyroost>
# Rendered and pushed automatically by .github/workflows/publish.yml;
# @PLACEHOLDERS@ are substituted from the release tag and SHA256SUMS.
pkgname=keyroost-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="CLI + GUI for programming Token2 Molto2 TOTP tokens and managing FIDO2/OATH/OpenPGP/PIV security keys (prebuilt)"
arch=('x86_64')
url="https://github.com/framefilter/keyroost"
license=('MIT OR Apache-2.0')
depends=('pcsclite')
optdepends=('ccid: smart-card reader drivers'
            'pcsc-tools: reader debugging')
provides=('keyroost' 'keyroostctl')
conflicts=('keyroost')
source=("keyroost-v$pkgver-linux-x86_64.tar.gz::$url/releases/download/v$pkgver/keyroost-v$pkgver-linux-x86_64.tar.gz"
        "70-keyroost-fido-$pkgver.rules::https://raw.githubusercontent.com/framefilter/keyroost/v$pkgver/udev/70-keyroost-fido.rules"
        "io.github.framefilter.keyroost-$pkgver.desktop::https://raw.githubusercontent.com/framefilter/keyroost/v$pkgver/packaging/flatpak/io.github.framefilter.keyroost.desktop"
        "io.github.framefilter.keyroost-$pkgver.svg::https://raw.githubusercontent.com/framefilter/keyroost/v$pkgver/packaging/icons/hicolor/scalable/apps/io.github.framefilter.keyroost.svg"
        "io.github.framefilter.keyroost-$pkgver.png::https://raw.githubusercontent.com/framefilter/keyroost/v$pkgver/packaging/icons/hicolor/256x256/apps/io.github.framefilter.keyroost.png")
sha256sums=('@SHA_LINUX@'
            '@SHA_UDEV@'
            '@SHA_DESKTOP@'
            '@SHA_ICON_SVG@'
            '@SHA_ICON_PNG@')

package() {
  install -Dm755 keyroostctl "$pkgdir/usr/bin/keyroostctl"
  install -Dm755 keyroost "$pkgdir/usr/bin/keyroost"
  install -Dm644 "70-keyroost-fido-$pkgver.rules" \
    "$pkgdir/usr/lib/udev/rules.d/70-keyroost-fido.rules"

  # Desktop launcher and app icon, so the GUI shows up in application menus.
  # The scalable SVG covers most desktops; the 256px PNG is for menus and
  # docks that don't render SVG icons, which scale it down as needed.
  install -Dm644 "io.github.framefilter.keyroost-$pkgver.desktop" \
    "$pkgdir/usr/share/applications/io.github.framefilter.keyroost.desktop"
  install -Dm644 "io.github.framefilter.keyroost-$pkgver.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.framefilter.keyroost.svg"
  install -Dm644 "io.github.framefilter.keyroost-$pkgver.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/io.github.framefilter.keyroost.png"

  # Shell completions (they call back into keyroostctl, so --device can
  # complete saved key names) and man pages, generated by the binary.
  # zsh isn't installed here: the generated script registers itself through
  # `compdef` and only works when sourced (as the README's zsh line does),
  # not when autoloaded from a $fpath file, so no file is shipped for it.
  install -d "$pkgdir/usr/share/bash-completion/completions" \
    "$pkgdir/usr/share/fish/vendor_completions.d" \
    "$pkgdir/usr/share/man/man1"
  ./keyroostctl completions bash > "$pkgdir/usr/share/bash-completion/completions/keyroostctl"
  ./keyroostctl completions fish > "$pkgdir/usr/share/fish/vendor_completions.d/keyroostctl.fish"
  ./keyroostctl manpage "$srcdir/man"
  install -m644 "$srcdir"/man/*.1 "$pkgdir/usr/share/man/man1/"
}
