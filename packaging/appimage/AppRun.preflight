#!/bin/sh
# keyroost AppImage launcher preflight.
#
# keyroost hard-links libpcsclite (the PC/SC client). The host's own copy is
# always preferred: it is the one guaranteed to match the host's pcscd. On a
# host with no libpcsclite at all, point the loader at the copy bundled in
# usr/lib/pcsc-fallback/ so keyroost still starts; with no pcscd there, the
# smart-card features just report unavailable and FIDO works as usual.
# https://github.com/framefilter/keyroost/issues/47
HERE="$(dirname "$(readlink -f "$0")")"

have_pcsclite() {
  PATH="/sbin:/usr/sbin:$PATH" ldconfig -p 2>/dev/null | grep -q 'libpcsclite\.so\.1' && return 0
  for d in /usr/lib /usr/lib64 /lib /lib64 /usr/lib/x86_64-linux-gnu /lib/x86_64-linux-gnu /usr/local/lib; do
    [ -e "$d/libpcsclite.so.1" ] && return 0
  done
  return 1
}

if ! have_pcsclite; then
  echo "keyroost: no PC/SC library (libpcsclite.so.1) on this system; smart-card" \
    "features will be unavailable. Install pcscd to use them." >&2
  LD_LIBRARY_PATH="$HERE/usr/lib/pcsc-fallback${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  export LD_LIBRARY_PATH
fi

exec "$HERE/AppRun.real" "$@"
